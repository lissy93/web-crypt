{
    "id": "./",
    "name": "web-crypt",
    "short_name": "web-crypt",
    "description": "Encrypt and decrypt messages and files with age and OpenPGP, all on your own device.",
    "lang": "en",
    "dir": "ltr",
    "start_url": "./",
    "scope": "./",
    "display": "standalone",
    "orientation": "any",
    "background_color": "#fbfbfa",
    "theme_color": "#fbfbfa",
    "categories": ["security", "utilities", "productivity"],
    "prefer_related_applications": false,
    "icons": [
        {
            "src": "icons/Icon-192.png",
            "sizes": "192x192",
            "type": "image/png"
        },
        {
            "src": "icons/Icon-512.png",
            "sizes": "512x512",
            "type": "image/png"
        },
        {
            "src": "icons/Icon-maskable-192.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "maskable"
        },
        {
            "src": "icons/Icon-maskable-512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "maskable"
        }
    ],
    "screenshots": [
        {
            "src": "screenshots/wide.webp",
            "sizes": "1180x820",
            "type": "image/webp",
            "form_factor": "wide",
            "label": "Encrypting a message with a passphrase"
        },
        {
            "src": "screenshots/narrow.webp",
            "sizes": "585x1266",
            "type": "image/webp",
            "form_factor": "narrow",
            "label": "Encrypting a message on a phone"
        }
    ],
    "shortcuts": [
        {
            "name": "Encrypt",
            "description": "Encrypt a message or a file",
            "url": "encrypt"
        },
        {
            "name": "Decrypt",
            "description": "Decrypt a message or a file",
            "url": "decrypt"
        },
        {
            "name": "Keys",
            "description": "Manage your age and PGP keys",
            "url": "keys"
        }
    ],
    "file_handlers": [
        {
            "action": "decrypt",
            "accept": {
                "application/pgp-encrypted": [".gpg", ".pgp", ".asc"],
                "application/x-age-encryption": [".age"]
            }
        }
    ],
    "launch_handler": {
        "client_mode": "focus-existing"
    }
}
